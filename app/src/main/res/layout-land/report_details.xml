<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/details_report" android:textSize="11sp" android:textColor="@color/muted" android:letterSpacing="0.1"/>
        <TextView android:id="@+id/profileSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/ink" android:textStyle="bold" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/measurementSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reference_title" android:textSize="16sp" android:textColor="@color/ink" android:textStyle="bold" android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/referenceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp"/>
    <Button android:id="@+id/chartButton" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/view_chart" android:textAllCaps="false" android:textColor="@color/teal"/>
    <Button android:id="@+id/editButton" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/edit" android:textAllCaps="false" android:textColor="@color/white" android:layout_marginTop="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/medical_note" android:textSize="11sp" android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="10dp"/>
    <include layout="@layout/advice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
</LinearLayout>
