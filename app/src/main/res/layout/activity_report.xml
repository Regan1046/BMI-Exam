<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/toolbar"/>
        <ScrollView android:id="@+id/root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true" android:baselineAligned="false">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/report_title" android:textSize="26sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/report_subtitle" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
                <include layout="@layout/report_result"/>
                <include layout="@layout/report_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
