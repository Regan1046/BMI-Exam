<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="@dimen/result_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adult_report" android:textSize="11sp" android:textColor="@color/teal" android:letterSpacing="0.1" android:textStyle="bold" android:id="@+id/reportGroup" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/warning_badge" android:textSize="12sp" android:textColor="@color/danger" android:textStyle="bold" android:id="@+id/warningBadge" android:gravity="center" android:layout_marginTop="@dimen/result_gap" android:visibility="gone" android:accessibilityLiveRegion="assertive"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bmi_label" android:textSize="11sp" android:textColor="@color/ink" android:letterSpacing="0.1" android:gravity="center" android:layout_marginTop="@dimen/result_gap"/>
    <TextView android:id="@+id/bmiValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/bmi_size" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bmi_unit" android:textSize="12sp" android:textColor="@color/muted" android:gravity="center"/>
    <TextView android:id="@+id/categoryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/category_size" android:textStyle="bold" android:textColor="@color/ink" android:gravity="center" android:layout_marginTop="@dimen/result_gap" android:accessibilityLiveRegion="polite"/>
    <TextView android:id="@+id/adviceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/ink" android:gravity="center" android:layout_marginTop="@dimen/result_gap" android:lineSpacingExtra="2dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/report_context_hint" android:textSize="11sp" android:textColor="@color/muted" android:id="@+id/reportContextHint" android:gravity="center" android:layout_marginTop="@dimen/result_gap"/>
</LinearLayout>
